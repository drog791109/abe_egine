{
  "schema_version": 1,
  "rules": [
    {
      "id": "adjacent_same_type_boost",
      "name": "同源共鸣",
      "category": "modifier",
      "trigger": {"event": "battle_start"},
      "conditions": [{"type": "adjacent_item_count", "tag_match": "same_category", "operator": ">=", "value": 1}],
      "effects": [{"type": "increase_item_power", "target": "self_and_matching_neighbors", "value": 2}],
      "costs": [],
      "limits": {"per_battle": 1},
      "ui_hint": "高亮相邻的同类道具。",
      "p1_priority": true
    },
    {
      "id": "destiny_double_start",
      "name": "天命初燃",
      "category": "modifier",
      "trigger": {"event": "battle_start"},
      "conditions": [{"type": "placed_on_cell", "cell_tag": "destiny"}],
      "effects": [{"type": "multiply_item_effect", "target": "source_item", "value": 2}],
      "costs": [],
      "limits": {"per_battle": 1},
      "ui_hint": "天命格与道具同时发光。",
      "p1_priority": true
    },
    {
      "id": "kill_generates_sword_intent",
      "name": "斩敌生意",
      "category": "trigger",
      "trigger": {"event": "enemy_killed"},
      "conditions": [{"type": "inventory_has_tag", "tag": "sword", "operator": ">=", "value": 1}],
      "effects": [{"type": "gain_resource", "resource": "sword_intent", "value": 1}],
      "costs": [],
      "limits": {"per_turn": 2},
      "ui_hint": "从被击败敌人连线到剑类道具。",
      "p1_priority": true
    },
    {
      "id": "injury_to_shield",
      "name": "受创凝甲",
      "category": "transform",
      "trigger": {"event": "actor_damaged"},
      "conditions": [{"type": "damage_amount", "operator": ">=", "value": 5}],
      "effects": [{"type": "gain_shield", "value": 3}],
      "costs": [{"type": "spend_resource", "resource": "spirit", "value": 1}],
      "limits": {"per_turn": 1},
      "ui_hint": "伤害数字收束为护盾边框。",
      "p1_priority": true
    },
    {
      "id": "delayed_pill_trigger",
      "name": "药力后发",
      "category": "modifier",
      "trigger": {"event": "pill_triggered"},
      "conditions": [{"type": "source_has_tag", "tag": "consumable"}],
      "effects": [{"type": "schedule_repeat", "delay_turns": 1, "power_ratio": 0.5}],
      "costs": [],
      "limits": {"per_item": 1},
      "ui_hint": "在时间轴上生成半透明延迟标记。",
      "p1_priority": true
    },
    {
      "id": "talisman_chain",
      "name": "符法连环",
      "category": "modifier",
      "trigger": {"event": "talisman_triggered"},
      "conditions": [{"type": "adjacent_item_count", "category": "talisman", "operator": ">=", "value": 1}],
      "effects": [{"type": "trigger_adjacent_item", "category": "talisman", "power_ratio": 0.6}],
      "costs": [],
      "limits": {"chain_depth": 1},
      "ui_hint": "相邻符箓之间显示单次传播连线。",
      "p1_priority": true
    },
    {
      "id": "star_core_tag_transform",
      "name": "星核化剑",
      "category": "transform",
      "trigger": {"event": "battle_start"},
      "conditions": [{"type": "inventory_has_tag", "tag": "star_core", "operator": ">=", "value": 1}],
      "effects": [{"type": "convert_tag_to_resource", "source_tag": "star_core", "resource": "sword_intent", "value_per_item": 2}],
      "costs": [],
      "limits": {"per_battle": 1},
      "ui_hint": "星核物品投射剑气图标。",
      "p1_priority": true
    },
    {
      "id": "pollute_slot_for_bonus",
      "name": "劫灰借力",
      "category": "cost",
      "trigger": {"event": "rule_triggered"},
      "conditions": [{"type": "source_has_tag", "tag": "pollution"}],
      "effects": [{"type": "increase_rule_power", "value": 4}],
      "costs": [{"type": "pollute_random_empty_cell", "value": 1}],
      "limits": {"per_battle": 2},
      "ui_hint": "先预告将被污染的格子，再结算强化。",
      "p1_priority": true
    },
    {
      "id": "armor_break_window_extend",
      "name": "裂隙延展",
      "category": "modifier",
      "trigger": {"event": "status_applied", "status": "armor_break"},
      "conditions": [{"type": "inventory_has_tag", "tag": "armor_break", "operator": ">=", "value": 2}],
      "effects": [{"type": "extend_status", "status": "armor_break", "turns": 1}],
      "costs": [],
      "limits": {"per_target": 1},
      "ui_hint": "延长目标状态条。",
      "p1_priority": false
    },
    {
      "id": "low_health_counter",
      "name": "困兽反击",
      "category": "condition",
      "trigger": {"event": "actor_damaged"},
      "conditions": [{"type": "health_ratio", "operator": "<=", "value": 0.3}],
      "effects": [{"type": "immediate_attack", "target": "damage_source", "power_ratio": 0.8}],
      "costs": [],
      "limits": {"per_turn": 1},
      "ui_hint": "低生命边框闪烁后立即反击。",
      "p1_priority": false
    },
    {
      "id": "array_plate_link",
      "name": "阵脉贯通",
      "category": "modifier",
      "trigger": {"event": "battle_start"},
      "conditions": [{"type": "connected_item_count", "source_category": "array", "operator": ">=", "value": 2}],
      "effects": [{"type": "increase_connected_power", "value": 1}],
      "costs": [],
      "limits": {"per_battle": 1},
      "ui_hint": "显示阵盘覆盖的连续路径。",
      "p1_priority": false
    },
    {
      "id": "same_row_focus",
      "name": "一线归元",
      "category": "condition",
      "trigger": {"event": "battle_start"},
      "conditions": [{"type": "same_row_item_count", "operator": ">=", "value": 3}],
      "effects": [{"type": "increase_same_row_power", "value": 2}],
      "costs": [],
      "limits": {"per_battle": 1},
      "ui_hint": "整行背包格短暂高亮。",
      "p1_priority": false
    },
    {
      "id": "first_strike_double",
      "name": "先声夺势",
      "category": "trigger",
      "trigger": {"event": "first_actor_attack"},
      "conditions": [{"type": "source_has_tag", "tag": "swift"}],
      "effects": [{"type": "repeat_attack", "power_ratio": 0.5}],
      "costs": [],
      "limits": {"per_battle": 1},
      "ui_hint": "首击后显示一次较弱追击。",
      "p1_priority": false
    },
    {
      "id": "vein_echo_reward",
      "name": "灵脉回响",
      "category": "trigger",
      "trigger": {"event": "battle_won"},
      "conditions": [{"type": "inventory_has_tag", "tag": "vein", "operator": ">=", "value": 2}],
      "effects": [{"type": "grant_loot", "loot_tag": "vein", "value": 1}],
      "costs": [],
      "limits": {"per_battle": 1},
      "ui_hint": "结算界面显示额外灵脉奖励。",
      "p1_priority": false
    },
    {
      "id": "mark_enemy_for_drop",
      "name": "寻痕索物",
      "category": "condition",
      "trigger": {"event": "enemy_killed"},
      "conditions": [{"type": "target_has_status", "status": "marked"}],
      "effects": [{"type": "increase_tagged_loot_chance", "value": 0.25}],
      "costs": [],
      "limits": {"per_enemy": 1},
      "ui_hint": "标记图案转移到掉落物。",
      "p1_priority": false
    },
    {
      "id": "stabilize_unstable_rule",
      "name": "定式归一",
      "category": "cost",
      "trigger": {"event": "unstable_rule_triggered"},
      "conditions": [{"type": "inventory_has_tag", "tag": "array", "operator": ">=", "value": 1}],
      "effects": [{"type": "guarantee_rule_success", "value": 1}],
      "costs": [{"type": "disable_item_for_battle", "target_tag": "array", "value": 1}],
      "limits": {"per_battle": 1},
      "ui_hint": "阵盘熄灭，规则结果转为稳定。",
      "p1_priority": false
    }
  ]
}
