MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=abe_engine
MYSQL_USER=abe
MYSQL_PASSWORD=abe123

RABBITMQ_DEFAULT_USER=abe
RABBITMQ_DEFAULT_PASS=abe123

# 代理配置（可选）：把 IP 和端口替换成自己的代理地址。
# compose 会把这些变量作为 dev 镜像构建参数，并注入 dev 容器运行环境。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1

# 当前 compose 使用 network_mode: host，服务直接监听宿主机默认端口。
# 如果需要修改端口，请同步调整 docker-compose.yml 中的服务监听配置和 dev 容器的 ABE_* 连接配置。
# MYSQL_PORT=3306
# REDIS_PORT=6379
# RABBITMQ_PORT=5672
# RABBITMQ_MGMT_PORT=15672
# ZOOKEEPER_PORT=2181
# KAFKA_PORT=9092

# Dockerfile 默认使用 UTC，并默认从源码构建 libjuice。
# TZ=UTC
# BUILD_LIBJUICE=1
# LIBJUICE_REF=
