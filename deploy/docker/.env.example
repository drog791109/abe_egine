MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=abe_engine
MYSQL_USER=abe
MYSQL_PASSWORD=abe123

RABBITMQ_DEFAULT_USER=abe
RABBITMQ_DEFAULT_PASS=abe123

# 基础镜像（可选）：默认走 public.ecr.aws，配置阿里云 mirror 后也可以改为 ubuntu:22.04。
# BASE_IMAGE=ubuntu:22.04

# 依赖服务镜像（可选）：默认使用可直接访问的镜像前缀，避免 Docker Hub 超时。
# 如果已经配置 Docker daemon 的阿里云 mirror，也可以改回 mysql:8.0、redis:7-alpine 等原始名称。
# MYSQL_IMAGE=m.daocloud.io/docker.io/mysql:8.0
# REDIS_IMAGE=m.daocloud.io/docker.io/redis:7-alpine
# RABBITMQ_IMAGE=m.daocloud.io/docker.io/rabbitmq:3-management
# ZOOKEEPER_IMAGE=m.daocloud.io/docker.io/zookeeper:3.9
# KAFKA_IMAGE=m.daocloud.io/docker.io/apache/kafka:3.7.0

# 代理配置（可选）：把 IP 和端口替换成自己的代理地址。
# compose 会把这些变量作为 dev 镜像构建参数，并注入 dev 容器运行环境。
# HTTP_PROXY=http://172.16.10.104:10811
# HTTPS_PROXY=http://172.16.10.104:10811
# NO_PROXY=localhost,127.0.0.1,::1

# Docker Hub 镜像加速（可选）：阿里云加速器地址是账号专属地址，需要从阿里云 ACR 控制台复制完整 URL。
# ALIYUN_MIRROR_URL=<从阿里云控制台复制的完整加速地址>

# 当前 compose 使用 network_mode: host，服务直接监听宿主机默认端口。
# 如果需要修改端口，请同步调整 docker-compose.yml 中的服务监听配置和 dev 容器的 ABE_* 连接配置。
# MYSQL_PORT=3306
# REDIS_PORT=6379
# RABBITMQ_PORT=5672
# RABBITMQ_MGMT_PORT=15672
# ZOOKEEPER_PORT=2181
# KAFKA_PORT=9092

# Dockerfile 默认使用 UTC。需要自定义构建参数时，可在 compose build 命令中传入。
# TZ=UTC
# LIBJUICE_REF=
